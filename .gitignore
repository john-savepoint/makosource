# FF7 Japanese Mod Project - Optimized .gitignore
# Created: 2026-01-24 19:10 JST
# Updated: 2026-01-26 22:12 JST
# Replaced 10,634-line bloated version with efficient patterns

# ============================================================================
# PROJECT-SPECIFIC IGNORES
# ============================================================================

# External repositories (cloned for reference)
FFNx/
PR737/

# Extracted game assets (use directory patterns, not individual files!)
ff7ovaremake/lgp_extracted/
japanese-assets-extracted/raw-files/
FF7-Japanese-Mod/lang-ja/
FF7-Japanese-Mod/mods/
assets/fonts/

# Working directories (development artifacts)
char_portrait_dbox/
font_sdf_converter/
font_sdf_converter */
video_title_charportrait/

# Chrome profile data (generated cache, never commit)
ai_imagen_background/scripts/higgsfield/.chrome_profile/

# Background updater artifacts
background_updater/output/
background_updater/*_output/
background_updater/test_*.png
background_updater/test_*.dds
background_updater/*.bin
background_updater/*.dat

# Font development artifacts (test images, debug outputs)
sdf_font/*.png
sdf_font/*.bmp
sdf_font/*.tiff
sdf_font/*.rgba
sdf_font/*.svg
sdf_font/*_test.*
sdf_font/*_debug.*
sdf_font/compare_*
sdf_font/skeleton*
sdf_font/test*
sdf_font/works.*

# Generated charset files (can be regenerated)
sdf_font/jafont_*_charset.txt

# Project/session management (Claude Code artifacts)
**/.project/
**/session-transcripts/
**/session_handoffs/

# Build artifacts
*.iro
build/
dist/

# ============================================================================
# CLAUDE CODE
# ============================================================================

# Claude ephemeral data (session files can be huge)
.claude/data/sessions/
.claude/logs/
.claude/cache/

# ============================================================================
# LANGUAGE-SPECIFIC
# ============================================================================

### Python ###
*.pyc
*.pyo
*.pyd
__pycache__/
.Python
env/
venv/
.venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

### Node.js ###
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.env
.env.local

### C/C++ ###
*.o
*.a
*.obj
*.lib
*.exe
*.out

### Rust ###
# Build artifacts
**/target/
*.rs.bk
*.pdb

# Cargo.lock: Commit for binary crates, ignore for libraries
# background_updater is a binary, so its Cargo.lock IS committed
!background_updater/Cargo.lock

