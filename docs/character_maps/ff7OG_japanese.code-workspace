    "search.followSymlinks": false,
    "search.useIgnoreFiles": true,
    "search.useGlobalIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,
    "search.smartCase": true,
    "search.maxResults": 20000,

    "git.autorefresh": false,
    "git.autofetch": false,
    "git.fetchOnPull": false,
    "git.decorations.enabled": true,
    "git.untrackedChanges": "separate",
    "git.scanRepositories": [],
    "git.repositoryScanMaxDepth": 1,
    "git.detectSubmodules": false,
    "git.showProgress": false,
    "git.statusLimit": 1000,
    "git.openRepositoryInParentFolders": "never",

    "scm.diffDecorations": "gutter",
    "scm.diffDecorationsGutterPattern": { "added": false, "modified": true },
    "scm.alwaysShowRepositories": false,

    "explorer.autoReveal": false,
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.js, ${capture}.d.ts.map, ${capture}.d.ts, ${capture}.js.map",
      "*.tsx": "${capture}.ts, ${capture}.js, ${capture}.test.ts, ${capture}.test.tsx",
      "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, .npmrc, .nvmrc, bun.lockb, .yarnrc.yml",
      ".gitignore": ".gitignore.backup-*, .gitignore.old-*, .gitignore.optimized, .gitattributes",
      "tsconfig.json": "tsconfig.*.json, tsconfig*.json",
      "astro.config.*": "tsconfig.json, *.config.*, .env*"
    },

    "typescript.tsserver.watchOptions": {
      "watchFile": "useFsEventsOnParentDirectory",
      "watchDirectory": "useFsEvents",
      "fallbackPolling": "dynamicPriority"
    },
    "typescript.disableAutomaticTypeAcquisition": true,
    "typescript.tsserver.maxTsServerMemory": 4096,
    "typescript.tsserver.experimental.useVsCodeWatcher": false,

    "telemetry.telemetryLevel": "error",
    "extensions.experimental.affinity": {
      "vscode.git": 1,
      "eamodio.gitlens": 1,
      "GitHub.copilot": 2,
      "GitHub.copilot-chat": 2
