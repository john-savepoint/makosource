{
  "manifest_version": 3,
  "name": "Higgsfield Multi-Select",
  "version": "1.0.0",
  "description": "Adds shift-click range selection to the Higgsfield AI image grid",
  "content_scripts": [
    {
      "matches": ["https://higgsfield.ai/*", "https://www.higgsfield.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
