# FF7 Japanese Mod Project - Optimized .gitignore
# Created: 2026-01-24 19:10 JST
# Replaced 10,634-line bloated version with efficient patterns

# ============================================================================
# PROJECT-SPECIFIC IGNORES
# ============================================================================

# External repositories (cloned for reference)
FFNx/
PR737/

# Extracted game assets (use directory patterns, not individual files!)
ff7ovaremake/lgp_extracted/
japanese-assets-extracted/raw-files/
FF7-Japanese-Mod/lang-ja/
FF7-Japanese-Mod/mods/
assets/fonts/

# Build artifacts
*.iro
build/
dist/

# ============================================================================
# CLAUDE CODE
# ============================================================================

# Claude ephemeral data (session files can be huge)
.claude/data/sessions/
.claude/logs/
.claude/cache/

